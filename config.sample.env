# GitLab connection
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=

# Comma-separated list of GitLab project IDs to monitor. Required if
# GITLAB_RUNNER_SCOPE=project. Optional under "group" scope: if left blank,
# every project under GITLAB_GROUP_IDS (including subgroups) is
# auto-discovered for job-failure polling; set it to restrict to a subset.
GITLAB_PROJECT_IDS=

# Comma-separated list of GitLab group IDs to monitor. Required if
# GITLAB_RUNNER_SCOPE=group. Pulls every runner available to the group
# (including its ancestor groups) plus failures from every project under it.
GITLAB_GROUP_IDS=

# "project" uses /projects/:id/runners (needs Maintainer or Auditor role on
#   the project; Reporter is NOT enough).
# "group" uses /groups/:id/runners (needs Owner or Auditor role in the group,
#   PLUS a token with the `manage_runner` scope, not just read_api) - use
#   this to pull in more runners at once instead of listing projects one by one.
# "instance" additionally calls /runners/all (requires an *admin* token) to
#   pick up shared runners.
GITLAB_RUNNER_SCOPE=group

# Polling + thresholds
POLL_INTERVAL_MINUTES=5
STALE_THRESHOLD_MINUTES=15
FAILURE_LOOKBACK_HOURS=24
HEALTH_SCORE_ALERT_THRESHOLD=70

# Teams (Power Automate "Post card in a chat or channel" workflow URL)
TEAMS_WEBHOOK_URL=
# If unset, alerts are logged to console/file instead of sent.

# Phase 2 - AI Reasoning Engine (root cause diagnosis given the job log +
# metadata + recurrence history).
AI_REASONING_ENABLED=true

# "openai_compatible" (default): any /v1/chat/completions-style endpoint,
# e.g. an internal model broker (see README for the pattern this follows).
# AI_API_KEY is a secret - never commit a real value here.
AI_PROVIDER=openai_compatible
AI_API_URL=
AI_API_KEY=
AI_MODEL=llama-3.3-70b

# "ollama": local/self-hosted Ollama instance instead, for offline dev use
# (set AI_PROVIDER=ollama to use these). From inside Docker/Kubernetes on
# Docker Desktop, host.docker.internal reaches a model server running on
# your host machine.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=mistral:latest

AI_REQUEST_TIMEOUT_SECONDS=60
LOG_EXCERPT_MAX_CHARS=4000

# Agentic tool-calling: lets the model decide to fetch more log context, the
# runner's recent failure history, or past diagnoses for this exact job
# before answering, instead of a fixed single-shot context blob. Only
# engages for AI_PROVIDER=openai_compatible (requires the broker to support
# OpenAI-style tool/function calling).
AI_AGENTIC_TOOLS_ENABLED=true
AI_AGENTIC_MAX_TOOL_ITERATIONS=4

# Trend analysis: how far back to look for recurring failures, and how many
# repeats of the exact same job failing count as "recurring" for the
# /trends/recurring-jobs endpoint.
TREND_WINDOW_DAYS=7
RECURRENCE_ALERT_THRESHOLD=3

# Storage
DATABASE_URL=sqlite:///./runner_health.db
